# Example environment variables for Stock Price Prediction API & Dashboard
# Copy this file to .env and customize as needed:
# cp .env.example .env

# Allowed CORS origins for the FastAPI backend (comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8501,http://127.0.0.1:8000

# Rate limiting for the /predict endpoint (requests per client IP per window)
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Concurrency ceiling for simultaneous model training executions
MAX_CONCURRENT_PREDICTIONS=2
